# Default app grid folders. Every studio app is in a folder; Steam alone
# stays on the grid's first page. Defaults, not locks: users can rearrange,
# rename or delete folders, and GNOME then keeps their own layout.
#
# GNOME Shell only writes its stock folders (Utilities, System) when
# folder-children is empty, so they are redefined here alongside the
# studio folders. An app listed in a folder that is not installed is simply
# not shown, so every studio app can be listed up front.
#
# Accounts that existed before this file shipped already have their own
# folder list. To switch one to these defaults, run this and then log out
# straight away; GNOME Shell 51's app grid breaks (empty grid, "page is
# undefined" errors) if folders change under a running session:
#   dconf reset -f /org/gnome/desktop/app-folders/
#   dconf reset /org/gnome/shell/app-picker-layout

[org/gnome/desktop/app-folders]
folder-children=['ArtCraft', 'JetBrains', 'Development', 'Media', 'Web', 'Communication', 'Utilities', 'System']

# Every app in files/system/usr/share/shatteredvales/artcraft-apps.list plus
# the launcher; verify-image.sh fails the build if the two drift apart.
[org/gnome/desktop/app-folders/folders/ArtCraft]
name='ArtCraft'
translate=false
apps=['ai.storyteller.artcraft-launcher.desktop', 'ai.storyteller.photocraft.desktop', 'ai.storyteller.vectorcraft.desktop', 'ai.storyteller.filmcraft.desktop', 'ai.storyteller.lightcraft.desktop', 'ai.storyteller.pdfcraft.desktop', 'ai.storyteller.effectcraft.desktop', 'ai.storyteller.anicraft.desktop', 'ai.storyteller.designcraft.desktop', 'ai.storyteller.figcraft.desktop', 'ai.storyteller.soundcraft.desktop', 'ai.storyteller.wordcraft.desktop', 'ai.storyteller.deckcraft.desktop', 'ai.storyteller.cadcraft.desktop', 'ai.storyteller.gridcraft.desktop', 'ai.storyteller.texturecraft.desktop', 'ai.storyteller.materialcraft.desktop', 'ai.storyteller.craft-anything.desktop']

# JetBrains Toolbox names each IDE's launcher with a per-install ID
# (jetbrains-rider-<uuid>.desktop), so the IDEs are matched by their IDE
# category instead. Every other app with that category is excluded here and
# listed under Development.
[org/gnome/desktop/app-folders/folders/JetBrains]
name='JetBrains'
translate=false
apps=['jetbrains-toolbox.desktop']
categories=['IDE']
excluded-apps=['com.microsoft.VSCode.desktop', 'com.microsoft.VSCode.UrlHandler.desktop', 'io.qt.QtCreator.desktop', 'org.godotengine.GodotSharp.desktop', 'com.google.AndroidStudio.desktop', 'io.dbeaver.DBeaverCommunity.desktop', 'org.geany.Geany.desktop']

[org/gnome/desktop/app-folders/folders/Development]
name='Development'
translate=false
apps=['shatteredvales-new-project.desktop', 'shatteredvales-github-setup.desktop', 'com.microsoft.VSCode.desktop', 'unityhub.desktop', 'com.unity.UnityHub.desktop', 'org.godotengine.GodotSharp.desktop', 'org.blender.Blender.desktop', 'org.inkscape.Inkscape.desktop', 'org.gimp.GIMP.desktop', 'com.google.AndroidStudio.desktop', 'io.qt.QtCreator.desktop', 'org.geany.Geany.desktop', 'io.dbeaver.DBeaverCommunity.desktop', 'com.getpostman.Postman.desktop', 'io.podman_desktop.PodmanDesktop.desktop', 'io.github.dvlv.boxbuddyrs.desktop', 'org.mapeditor.Tiled.desktop', 'io.github.f3d_app.f3d.desktop', 'renderdoc.desktop', 'io.github.wivrn.wivrn.desktop', 'virt-manager.desktop', 'org.kde.krita.desktop', 'com.github.PintaProject.Pinta.desktop', 'claude-desktop-unofficial.desktop']

[org/gnome/desktop/app-folders/folders/Media]
name='Media'
translate=false
apps=['org.videolan.VLC.desktop', 'com.makemkv.MakeMKV.desktop', 'fr.handbrake.ghb.desktop', 'org.gnome.Decibels.desktop', 'org.audacityteam.Audacity.desktop', 'com.obsproject.Studio.desktop', 'org.gnome.Showtime.desktop', 'org.gnome.Snapshot.desktop']

[org/gnome/desktop/app-folders/folders/Web]
name='Web'
translate=false
apps=['org.mozilla.firefox.desktop', 'chromium-browser.desktop']

# Chat apps are matched by category so new ones join automatically.
[org/gnome/desktop/app-folders/folders/Communication]
