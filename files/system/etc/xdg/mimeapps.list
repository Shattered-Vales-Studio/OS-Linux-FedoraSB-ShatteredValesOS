# Studio default applications. Applies to every account; anything a user
# picks in Settings > Apps > Default Apps or Open With > Always takes precedence.
# Each type lists apps in order: when the first isn't installed (yet), the
# next is used. Craft apps install for each user at first login.

[Default Applications]

# Email and calendar (Thunderbird)
x-scheme-handler/mailto=net.thunderbird.Thunderbird.desktop;
message/rfc822=net.thunderbird.Thunderbird.desktop;
text/calendar=net.thunderbird.Thunderbird.desktop;
text/vcard=net.thunderbird.Thunderbird.desktop;

