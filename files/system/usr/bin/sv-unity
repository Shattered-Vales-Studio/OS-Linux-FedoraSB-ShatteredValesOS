#!/usr/bin/env bash
#
# sv-unity
#
# Purpose:
#   Gets the exact Unity editor a project needs, so opening a project from
#   GitHub just works. Uses the Unity CLI (`unity`, installed per user at
#   first login) to install the editor version named in the project's
#   ProjectSettings/ProjectVersion.txt, adds the Android build module with
#   its SDK, NDK and OpenJDK for Android, WearOS and Meta Quest builds, and
#   can open the project in that editor. Unity Hub 4 no longer has a command
#   line, which is why this goes through the Unity CLI.
#
# Usage:
#   sv-unity [project-dir]               Install the project's editor (and
#                                        Android module) if missing.
#   sv-unity open [project-dir]          The same, then open the project.
#   sv-unity --no-android [...]          Skip the Android module.
#   project-dir defaults to the Unity project containing the current folder.
#
# Exit codes:
#   0 on success, 1 on failure, 64 on bad usage.

set -euo pipefail

# say
#   Prints a highlighted progress line.
#   Arguments: message words
#   Returns: 0 always
say() {
    printf '\n\033[1;33m==>\033[0m \033[1m%s\033[0m\n' "$*"
}

# die
#   Prints an error and exits.
#   Arguments: message words
#   Returns: does not return
die() {
    printf '\033[1;31mError:\033[0m %s\n' "$*" >&2
    exit 1
}

# find_project
#   Finds the Unity project root: the given folder, or the nearest folder
#   upwards from the current one that contains ProjectSettings/ProjectVersion.txt.
#   Arguments: $1 optional starting folder
#   Output: absolute project path
#   Returns: does not return if no project is found
find_project() {
    local dir
    dir="$(cd "${1:-.}" 2>/dev/null && pwd)" || die "No such folder: ${1}"
    while [[ "${dir}" != / ]]; do
        [[ -f "${dir}/ProjectSettings/ProjectVersion.txt" ]] && { printf '%s' "${dir}"; return 0; }
        dir="$(dirname "${dir}")"
    done
    die "Not inside a Unity project (no ProjectSettings/ProjectVersion.txt found)."
}

# main
#   Installs the project's editor and Android module as needed, optionally
#   opening the project.
#   Arguments: see Usage
#   Returns: 0 on success, 64 on bad usage
main() {
    local open=0 android=1 target="" project version editor_dir
    while (( $# )); do
        case "$1" in
            open) open=1 ;;
            --no-android) android=0 ;;
            -h|--help) sed -n '/^# Usage:/,/^#$/p' "$0" | sed 's/^# \{0,3\}//'; exit 0 ;;
            -*) echo "Unknown option: $1" >&2; exit 64 ;;
            *) target="$1" ;;
        esac
        shift
    done
    command -v unity >/dev/null \
        || die "The Unity CLI isn't installed for this account yet. Run sv-first-login, then open a new terminal."

    project="$(find_project "${target}")"
    version="$(sed -n 's/^m_EditorVersion: *//p' "${project}/ProjectSettings/ProjectVersion.txt" | tr -d '\r')"
    [[ -n "${version}" ]] || die "Could not read the editor version from ProjectVersion.txt."
    say "$(basename "${project}") uses Unity ${version}"

    # Installs the exact version (with its changeset) only when it's missing.
    # --yes confirms the install the user asked for by running this command;
    # licence and terms prompts are left for the user to answer.
    unity projects require "${project}" --yes

    if (( android )); then
        # Take any absolute path in the JSON answer that names this version,
        # so a renamed field in a newer CLI doesn't break the check.
        editor_dir="$(unity editors path "${version}" --format json 2>/dev/null \
            | jq -r --arg v "${version}" '[.. | strings | select(startswith("/") and contains($v))][0] // empty' \
            | sed -E "s#(/${version//./\\.})/.*#\\1#")"
        if [[ -n "${editor_dir}" && -d "${editor_dir}/Editor/Data/PlaybackEngines/AndroidPlayer" ]]; then
            echo "Android build support is installed."
        else
            say "Adding Android build support (SDK, NDK and OpenJDK)"
            unity install-modules --editor-version "${version}" --module android --child-modules
        fi
    fi

    if (( open )); then
        say "Opening the project"
        unity open "${project}"
    else
        echo "Open it with: sv-unity open"
    fi
}

main "$@"
