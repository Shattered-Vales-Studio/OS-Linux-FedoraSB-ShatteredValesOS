#!/usr/bin/env bash
#
# sv-new-project
#
# Purpose:
#   Starts a new project from the studio's Claude Code template
#   (Shattered-Vales-Studio/Template-ClaudeProject) and drops straight into
#   the design interview:
#     1. With a repository name: creates the GitHub repository from the
#        template, clones it into ~/Source/<name> and runs the template's
#        scripts/setup-repo.sh (labels, dev and qa branches).
#        Without one: copies the template into a local folder in ~/Source
#        that can be published to GitHub later.
#     2. Starts Claude Code in the project with the template's design
#        interview prompt ("Interview me until the design is clear..."),
#        optionally seeded with a short description of the project.
#     3. Leaves you in a shell in the project folder when Claude exits.
#   If the template gains a /interview command (.claude/commands/
#   interview.md), that command is used instead of the built-in prompt.
#
# Usage:
#   sv-new-project [repo-name] [options]
#     --public               Make the GitHub repository public (default private)
#     --owner <org-or-user>  Where to create it (default Shattered-Vales-Studio)
#     --about "<text>"       Short description of the project for the interview
#   With no repo-name it asks; leave the answer empty for a local-only folder.
#
# Exit codes:
#   0 on success, 1 on failure, 64 on bad usage. When Claude exits, the
#   process is replaced by your shell in the project folder.

set -euo pipefail

readonly TEMPLATE="Shattered-Vales-Studio/Template-ClaudeProject"
readonly SOURCE_DIR="${HOME}/Source"
readonly NAME_PATTERN='^[A-Za-z0-9._-]+$'

# say
#   Prints a highlighted progress line.
#   Arguments: message words
#   Returns: 0 always
say() {
    printf '\n\033[1;33m==>\033[0m \033[1m%s\033[0m\n' "$*"
}

# die
#   Prints an error and exits.
#   Arguments: message words
#   Returns: does not return
die() {
    printf '\033[1;31mError:\033[0m %s\n' "$*" >&2
    exit 1
}

# require_tools
#   Checks that Claude Code and a signed-in GitHub CLI are available.
#   Arguments: none
#   Returns: does not return if something is missing
require_tools() {
    command -v claude >/dev/null \
        || die "Claude Code is not installed for this account yet. Run sv-first-login, then open a new terminal."
    gh auth status --hostname github.com >/dev/null 2>&1 \
        || die "The GitHub CLI is not signed in. Open GitHub Setup (or run: sv-github setup) first."
}

# interview_prompt
#   Builds the opening message for Claude: the template's /interview command
#   if the project has one, otherwise the design interview prompt from the
#   template's README (step 2), with the project description filled in.
#   Arguments: $1 project directory, $2 description (may be empty)
#   Output: the prompt on stdout
#   Returns: 0 always
interview_prompt() {
    local dir="$1" about="$2"
    if [[ -f "${dir}/.claude/commands/interview.md" ]]; then
        printf '/interview %s' "${about}"
        return 0
    fi
    local project
    if [[ -n "${about}" ]]; then
        project="The project is: ${about}"
    else
        project="I haven't described the project yet: start by asking me what it is (what, who for, platforms, language, how it's delivered, what makes it hard)."
    fi
    cat <<EOF
I'm starting a new project from a template whose design documents live in .claude/
(SPEC.md, ARCHITECTURE.md, ROADMAP.md, TESTING.md, GLOSSARY.md, OPEN_QUESTIONS.md,
SECRETS.md) plus a short CLAUDE.md. ${project}

Interview me until the design is clear, a few questions at a time. Then fill in the
documents, keeping the template's structure:
- SPEC.md: numbered sections of testable rules with worked examples.
- ARCHITECTURE.md: components, packages and allowed dependencies, concurrency,
  storage, security; reasons for each choice.
- ROADMAP.md: milestones small enough for one PR each, ordered so each builds on
  finished ones, each with a mechanical "Done when".
- GLOSSARY.md: every domain noun, one meaning each.
- OPEN_QUESTIONS.md: everything we didn't settle, with a proposed default, and
  everything we did settle, with the reason.
- CLAUDE.md: the project paragraph, commands, layout, numbered ground rules
  (architectural boundaries, sources of truth, security invariants), conventions,
  and pre-approved dependencies.
Replace every {{PLACEHOLDER}} and remove the TEMPLATE comments and example entries.
EOF
}

# wait_for_template_copy
#   GitHub copies template contents asynchronously, so a clone straight
#   after `gh repo create` can come back empty. Waits up to a minute for the
#   new repository's main branch to exist.
#   Arguments: $1 owner/name
#   Returns: 1 if the branch never appears
wait_for_template_copy() {
    local attempt
    for attempt in $(seq 1 30); do
        gh api "repos/$1/git/ref/heads/main" >/dev/null 2>&1 && return 0
        (( attempt == 1 )) && echo "Waiting for GitHub to finish copying the template..."
        sleep 2
    done
    return 1
}

# create_github_project
#   Creates the repository from the template, clones it and runs the
#   template's repository setup.
#   Arguments: $1 owner, $2 repository name, $3 visibility flag
#   Output: the project directory on stdout (progress goes to stderr)
#   Returns: non-zero on failure
create_github_project() {
    local owner="$1" name="$2" visibility="$3" dir="${SOURCE_DIR}/$2"
    [[ ! -e "${dir}" ]] || die "${dir} already exists."
    {
        say "Creating ${owner}/${name} from ${TEMPLATE}"
        gh repo create "${owner}/${name}" "${visibility}" --template "${TEMPLATE}"
        wait_for_template_copy "${owner}/${name}" || die "GitHub did not finish copying the template; try: gh repo clone ${owner}/${name}"
        gh repo clone "${owner}/${name}" "${dir}"
        say "Setting up labels and the dev and qa branches"
        (cd "${dir}" && bash scripts/setup-repo.sh "${owner}/${name}")
    } >&2
    printf '%s' "${dir}"
}

# create_local_project
#   Copies the template into a new local folder with fresh Git history, for
#   projects that are not on GitHub yet.
#   Arguments: $1 folder name
#   Output: the project directory on stdout (progress goes to stderr)
#   Returns: non-zero on failure
create_local_project() {
    local name="$1" dir="${SOURCE_DIR}/$1"
    [[ ! -e "${dir}" ]] || die "${dir} already exists."
    {
        say "Creating local project ${dir} from ${TEMPLATE}"
        gh repo clone "${TEMPLATE}" "${dir}" -- --depth 1
        rm -rf "${dir}/.git"
        git -C "${dir}" init -q -b main
        git -C "${dir}" add -A
        git -C "${dir}" commit -q -m "chore: start project from ${TEMPLATE##*/}"
    } >&2
    printf '%s' "${dir}"
}

# main
#   Parses arguments, creates the project, starts the interview and leaves
#   the user in a shell in the project folder.
#   Arguments: see Usage
#   Returns: does not return on success (replaced by the user's shell)
main() {
    local name="" owner="Shattered-Vales-Studio" visibility="--private" about="" dir
    while (( $# )); do
        case "$1" in
            --public) visibility="--public" ;;
            --owner) owner="${2:?--owner needs a value}"; shift ;;
            --about) about="${2:?--about needs a value}"; shift ;;
            -h|--help) sed -n '/^# Usage:/,/^#$/p' "$0" | sed 's/^# \{0,3\}//'; exit 0 ;;
            -*) echo "Unknown option: $1" >&2; exit 64 ;;
            *) [[ -z "${name}" ]] || { echo "Only one repository name, please." >&2; exit 64; }
               name="$1" ;;
        esac
        shift
    done

    require_tools
    mkdir -p "${SOURCE_DIR}"

    local github=1
    if [[ -z "${name}" ]]; then
        read -r -p "GitHub repository name (leave empty for a local-only folder): " name
        if [[ -z "${name}" ]]; then
            github=0
            read -r -p "Folder name for the project: " name
        fi
    fi
    [[ "${name}" =~ ${NAME_PATTERN} ]] || die "Use letters, digits, dots, dashes or underscores for the name."
    if [[ -z "${about}" ]]; then
        read -r -p "Describe the project in a sentence or two (Enter to let Claude ask): " about
    fi

    if (( github )); then
        dir="$(create_github_project "${owner}" "${name}" "${visibility}")"
    else
        dir="$(create_local_project "${name}")"
    fi

    cd "${dir}"
    say "Starting the design interview in ${dir}"
    echo "Answer Claude's questions; it fills in the design documents at the end."
    if (( github )); then
        echo "Afterwards, commit the documents to main yourself, then run: git push origin main:dev main:qa"
    else
        echo "To publish later: gh repo create ${owner}/${name} --private --source . --push && scripts/setup-repo.sh"
    fi
    echo
    # Scripts don't see the interactive shell's claude wrapper, so pass the
    # GitHub CLI's token for the organization's GitHub MCP server here too.
    if [[ -z "${GITHUB_PERSONAL_ACCESS_TOKEN:-}" ]]; then
        GITHUB_PERSONAL_ACCESS_TOKEN="$(gh auth token 2>/dev/null || true)" \
            claude "$(interview_prompt "${dir}" "${about}")" || true
    else
        claude "$(interview_prompt "${dir}" "${about}")" || true
    fi

    say "You're in ${dir}. Type 'exit' to close this shell."
    exec "${SHELL:-/bin/bash}"
}

main "$@"
