#!/usr/bin/env bash
#
# sv-github
#
# Purpose:
#   Sets up GitHub access the way the studio guides describe, without
#   copying commands by hand:
#     setup        "Your First Day" Step 5 and "Daily Git Terminal
#                  Workflow" Step 1: Git identity, GitHub CLI sign-in, an
#                  ed25519 SSH key uploaded with `gh ssh-key add`, and
#                  ~/Source.
#     add-profile  "Managing Multiple GitHub SSH Keys": a named key, an SSH
#                  host alias and the key added to the second account.
#     use / clone  That guide's Step 4 and "Local Git Config" tip: point a
#                  repository at a profile and set its commit identity.
#   Guides: https://shatteredvales.studio/guide/
#
# Usage:
#   sv-github setup [--wait]
#   sv-github add-profile <alias>
#   sv-github use <alias>                 (inside a repository)
#   sv-github clone <alias> <owner/repo>  (clones into ~/Source)
#   sv-github list
#   sv-github test [alias]
#
# State:
#   ~/.ssh/config gets one managed block per host, between
#   "# >>> sv-github <host> >>>" markers; everything else is left alone.
#   Profiles are recorded in ~/.config/shatteredvales/github-profiles/.
#
# Exit codes:
#   0 on success, 1 on failure, 64 on bad usage.

set -euo pipefail

readonly ORG="Shattered-Vales-Studio"
readonly GUIDES_URL="https://shatteredvales.studio/guide/"
readonly SSH_DIR="${HOME}/.ssh"
readonly SSH_CONFIG="${SSH_DIR}/config"
readonly KNOWN_HOSTS="${SSH_DIR}/known_hosts"
readonly PROFILE_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/shatteredvales/github-profiles"
readonly SOURCE_DIR="${HOME}/Source"
readonly DEFAULT_KEY="${SSH_DIR}/id_ed25519"

# say
#   Prints a highlighted progress line.
#   Arguments: message words
#   Returns: 0 always
say() {
    printf '\n\033[1;33m==>\033[0m \033[1m%s\033[0m\n' "$*"
}

# die
#   Prints an error and exits.
#   Arguments: message words
#   Returns: does not return
die() {
    printf '\033[1;31mError:\033[0m %s\n' "$*" >&2
    exit 1
}

# ask
#   Prompts for a value, offering a default.
#   Arguments: $1 prompt, $2 default (may be empty)
#   Output: the answer, or the default when the user just presses Enter
#   Returns: 0 always
ask() {
    local reply
    read -r -p "$1${2:+ [$2]}: " reply
    printf '%s' "${reply:-$2}"
}

# confirm
#   Asks a yes/no question that defaults to yes.
#   Arguments: $1 question
#   Returns: 0 for yes, 1 for no
confirm() {
    local reply
    read -r -p "$1 [Y/n] " reply
    [[ ! "${reply}" =~ ^[Nn] ]]
}

# require_email
#   Prompts until a plausible email address is entered.
#   Arguments: $1 prompt, $2 default
#   Output: the email address
#   Returns: 0 always
require_email() {
    local email
    while true; do
        email="$(ask "$1" "$2")"
        [[ "${email}" == *@*.* ]] && { printf '%s' "${email}"; return 0; }
        echo "Please enter a valid email address." >&2
    done
}

# ensure_ssh_dir
#   Creates ~/.ssh and its config file with the permissions OpenSSH
#   requires.
#   Arguments: none
#   Returns: 0 always
ensure_ssh_dir() {
    mkdir -p "${SSH_DIR}"
    chmod 700 "${SSH_DIR}"
    touch "${SSH_CONFIG}" "${KNOWN_HOSTS}"
    chmod 600 "${SSH_CONFIG}"
}

# trust_github_host_keys
#   Adds GitHub's published SSH host keys to known_hosts, fetched over the
#   authenticated HTTPS API, so the first connection needs no "are you sure"
#   prompt and cannot be intercepted.
#   Arguments: none
#   Returns: non-zero if the GitHub API cannot be reached
trust_github_host_keys() {
    local key
    while read -r key; do
        grep -qF "github.com ${key}" "${KNOWN_HOSTS}" || echo "github.com ${key}" >> "${KNOWN_HOSTS}"
    done < <(gh api meta --jq '.ssh_keys[]')
}

# write_host_block
#   Writes or replaces the managed ~/.ssh/config block for a GitHub host,
#   placed at the top of the file so it takes precedence over older
#   hand-written entries. IdentitiesOnly stops the SSH agent offering a
#   different account's key first, which GitHub would accept as the wrong
#   user.
#   Arguments: $1 host name or alias, $2 private key path
#   Returns: 0 always
write_host_block() {
    local host="$1" key="$2" begin end tmp
    begin="# >>> sv-github ${host} >>>"
    end="# <<< sv-github ${host} <<<"
    tmp="$(mktemp)"
    {
        printf '%s\n' "${begin}" \
            "Host ${host}" \
            "    HostName github.com" \
            "    User git" \
            "    IdentityFile ${key/#${HOME}/\~}" \
            "    IdentitiesOnly yes" \
            "${end}" ""
        # Drop the old block and the blank line that follows it, so rewriting
        # a block never accumulates empty lines.
        awk -v b="${begin}" -v e="${end}" '
            $0 == b { skip = 1; next }
            skip && $0 == e { skip = 0; trim = 1; next }
            skip { next }
            trim && $0 == "" { trim = 0; next }
            { trim = 0; print }
        ' "${SSH_CONFIG}"
    } > "${tmp}"
    cat "${tmp}" > "${SSH_CONFIG}"
    rm -f "${tmp}"
}

# generate_key
#   Creates an ed25519 key unless one already exists at the path.
#   ssh-keygen prompts for the passphrase itself.
#   Arguments: $1 private key path, $2 email used as the key comment
#   Returns: ssh-keygen's exit status
generate_key() {
    local key="$1" email="$2"
    if [[ -f "${key}" ]]; then
        echo "Using the existing key ${key}."
        return 0
    fi
    echo "A passphrase is recommended; it protects the key if this machine is lost."
    ssh-keygen -t ed25519 -C "${email}" -f "${key}"
}

# gh_login
#   Signs the GitHub CLI in through the browser if needed, and makes sure
#   the token can manage SSH keys.
#   Arguments: none
#   Returns: gh's exit status
gh_login() {
    if ! gh auth status --hostname github.com >/dev/null 2>&1; then
        echo "A browser window opens. Sign in, enter the one-time code shown here,"
        echo "and approve the ${ORG} organization if asked."
        gh auth login --hostname github.com --git-protocol ssh --web \
            --skip-ssh-key --scopes admin:public_key
    elif ! gh auth status --hostname github.com 2>&1 | grep -q 'admin:public_key'; then
        gh auth refresh --hostname github.com --scopes admin:public_key
    fi
}

# active_login
#   Prints the GitHub username the CLI is currently using.
#   Arguments: none
#   Returns: non-zero if the CLI is not signed in
active_login() {
    gh api user --jq .login 2>/dev/null
}

# upload_key
#   Adds a public key to the GitHub account the CLI is signed in as.
#   A key that is already on the account counts as success.
#   Arguments: $1 public key path, $2 title shown on GitHub
#   Returns: 0 on success, 1 otherwise
upload_key() {
    local output
    if output="$(gh ssh-key add "$1" --title "$2" 2>&1)"; then
        echo "Key added to GitHub."
        return 0
    fi
    if grep -qi 'already' <<<"${output}"; then
        echo "That key is already on the account."
        return 0
    fi
    echo "${output}" >&2
    return 1
}

# test_ssh
#   Confirms GitHub accepts the key for a host and greets the expected user.
#   Arguments: $1 host name or alias
#   Returns: 0 if GitHub authenticated the key, 1 otherwise
test_ssh() {
    local output
    # GitHub always exits 1 here because it offers no shell; the greeting is
    # the real signal.
    output="$(ssh -T -o BatchMode=yes -o ConnectTimeout=10 "git@$1" 2>&1 || true)"
    echo "${output}"
    grep -q 'successfully authenticated' <<<"${output}"
}

# save_profile
#   Records a profile so `use` and `clone` can apply it later.
#   Arguments: $1 alias, $2 SSH host, $3 name, $4 email, $5 GitHub login
#   Returns: 0 always
save_profile() {
    mkdir -p "${PROFILE_DIR}"
    printf 'HOST=%s\nNAME=%s\nEMAIL=%s\nLOGIN=%s\n' "$2" "$3" "$4" "$5" \
        > "${PROFILE_DIR}/$1"
}

# profile_field
#   Reads one field from a saved profile without sourcing the file.
#   Arguments: $1 alias, $2 field name (HOST, NAME, EMAIL or LOGIN)
#   Output: the field value
#   Returns: 1 if the profile does not exist
profile_field() {
    local file="${PROFILE_DIR}/$1"
    [[ -f "${file}" ]] || return 1
    sed -n "s/^$2=//p" "${file}"
}

# validate_alias
#   Rejects aliases that would make an awkward host name or file name.
#   Arguments: $1 alias
#   Returns: does not return if the alias is invalid
validate_alias() {
    [[ "$1" =~ ^[a-z0-9][a-z0-9-]*$ ]] \
        || die "Use lowercase letters, digits and dashes for the alias (for example: personal)."
}

# github_path
#   Extracts owner/repo from any GitHub remote URL form (HTTPS, SSH or an
#   sv-github alias).
#   Arguments: $1 remote URL
#   Output: owner/repo without the .git suffix
#   Returns: 1 if the URL is not a GitHub URL
github_path() {
    local path
    path="$(sed -nE 's#^(https://github\.com/|git@github(-[a-z0-9-]+|\.com):|ssh://git@github\.com/)##p' <<<"$1")"
    [[ -n "${path}" ]] || return 1
    printf '%s' "${path%.git}"
}

# cmd_setup
#   First-time GitHub setup for the main account, following "Your First
#   Day" Step 5.
#   Arguments: $1 optional --wait (pause before exiting, for the launcher)
#   Returns: 0 on success, 1 on failure
cmd_setup() {
    local name email gecos login failed=0
    say "GitHub setup for $(hostname)"
    echo "This follows the studio guide: ${GUIDES_URL}github/yourfirstday.html"

    say "Your commit identity"
    gecos="$(getent passwd "${USER}" | cut -d: -f5 | cut -d, -f1)"
    name="$(ask "Full name" "$(git config --global user.name || printf '%s' "${gecos}")")"
    email="$(require_email "Studio email (verified on your GitHub account)" \
        "$(git config --global user.email || true)")"
    git config --global user.name "${name}"
    git config --global user.email "${email}"

    say "Signing in to the GitHub CLI"
    gh_login || die "GitHub CLI sign-in failed."
    login="$(active_login)" || die "The GitHub CLI is not signed in."
    echo "Signed in as ${login}."

    say "SSH key"
    ensure_ssh_dir
    trust_github_host_keys || die "Could not reach GitHub to fetch its host keys."
    generate_key "${DEFAULT_KEY}" "${email}"
    write_host_block github.com "${DEFAULT_KEY}"
    upload_key "${DEFAULT_KEY}.pub" "$(hostname) (Shattered Vales OS)" || failed=1

    say "Testing the connection"
    test_ssh github.com || failed=1
    save_profile default github.com "${name}" "${email}" "${login}"
    mkdir -p "${SOURCE_DIR}"

    if (( failed )); then
        say "Setup finished with problems; see the messages above."
    else
        say "All set"
        echo "Repositories you can access:   gh repo list ${ORG} --limit 50"
        echo "Clone into ~/Source:           cd ~/Source && gh repo clone ${ORG}/<repo>"
        echo "What is waiting on you:        gh status"
        echo "Second GitHub account:         sv-github add-profile <alias>"
    fi
    if [[ "${1:-}" == --wait ]]; then
        read -r -p $'\nPress Enter to close.' _
    fi
    return "${failed}"
}

# cmd_add_profile
#   Adds a second GitHub account with its own key and host alias, following
#   "Managing Multiple GitHub SSH Keys".
#   Arguments: $1 alias (the host becomes github-<alias>)
#   Returns: 0 on success, 1 on failure
cmd_add_profile() {
    local alias="${1:-}" host key name email previous login=""
    [[ -n "${alias}" ]] || die "Usage: sv-github add-profile <alias>"
    validate_alias "${alias}"
    [[ "${alias}" != default ]] || die "'default' is reserved for the account set up by 'sv-github setup'."
    host="github-${alias}"
    key="${SSH_DIR}/github-${alias}"

    say "New GitHub profile '${alias}' (host alias ${host})"
    name="$(ask "Name for commits made with this account" "$(git config --global user.name || true)")"
    email="$(require_email "Email verified on that GitHub account" "")"

    ensure_ssh_dir
    trust_github_host_keys || die "Could not reach GitHub to fetch its host keys."
    generate_key "${key}" "${email}"
    write_host_block "${host}" "${key}"

    say "Adding the key to the '${alias}' GitHub account"
    if confirm "Sign that account into the GitHub CLI to add the key automatically?"; then
        previous="$(active_login || true)"
        echo "In the browser, make sure you sign in as the '${alias}' account, not ${previous:-your main account}."
        echo "A private browser window makes that easiest."
        gh auth login --hostname github.com --git-protocol ssh --web \
            --skip-ssh-key --scopes admin:public_key || die "Sign-in failed."
        login="$(active_login)"
        if [[ -n "${previous}" && "${login}" == "${previous}" ]]; then
            die "Still signed in as ${previous}. Run this again and sign in with the other account."
        fi
        upload_key "${key}.pub" "$(hostname) (Shattered Vales OS)" || die "Could not add the key."
        if [[ -n "${previous}" ]]; then
            gh auth switch --hostname github.com --user "${previous}"
            echo "The GitHub CLI is back on ${previous}. Switch with: gh auth switch"
        fi
    else
        wl-copy < "${key}.pub" 2>/dev/null && echo "The public key is on your clipboard."
        echo "Sign in to the '${alias}' account, paste it as a new SSH key, then come back here."
        xdg-open "https://github.com/settings/ssh/new" >/dev/null 2>&1 || true
        read -r -p "Press Enter once the key is added." _
    fi

    say "Testing the connection"
    test_ssh "${host}" || die "GitHub did not accept the key for ${host}."
    save_profile "${alias}" "${host}" "${name}" "${email}" "${login}"

    say "Profile '${alias}' is ready"
    echo "Clone with it:              sv-github clone ${alias} <owner/repo>"
    echo "Switch an existing repo:    cd <repo> && sv-github use ${alias}"
}

# cmd_use
#   Points the current repository's origin at a profile's host and sets the
#   repository's commit identity to match.
#   Arguments: $1 alias
#   Returns: 0 on success, 1 on failure
cmd_use() {
    local alias="${1:-}" host url path
    [[ -n "${alias}" ]] || die "Usage: sv-github use <alias>"
    host="$(profile_field "${alias}" HOST)" || die "No profile named '${alias}'. See: sv-github list"
    git rev-parse --git-dir >/dev/null 2>&1 || die "Run this inside a Git repository."
    url="$(git remote get-url origin)" || die "This repository has no 'origin' remote."
    path="$(github_path "${url}")" || die "origin is not a GitHub URL: ${url}"

    git remote set-url origin "git@${host}:${path}.git"
    git config user.name "$(profile_field "${alias}" NAME)"
    git config user.email "$(profile_field "${alias}" EMAIL)"
    echo "origin  -> git@${host}:${path}.git"
    echo "commits -> $(git config user.name) <$(git config user.email)>"
}

# cmd_clone
#   Clones a repository into ~/Source through a profile and applies the
#   profile's commit identity.
#   Arguments: $1 alias, $2 owner/repo
#   Returns: git's exit status
cmd_clone() {
    local alias="${1:-}" repo="${2:-}" host
    [[ -n "${alias}" && "${repo}" == */* ]] || die "Usage: sv-github clone <alias> <owner/repo>"
    host="$(profile_field "${alias}" HOST)" || die "No profile named '${alias}'. See: sv-github list"
    mkdir -p "${SOURCE_DIR}"
    git clone "git@${host}:${repo%.git}.git" "${SOURCE_DIR}/${repo##*/}"
    (cd "${SOURCE_DIR}/${repo##*/}" && cmd_use "${alias}")
}

# cmd_list
#   Shows every saved profile.
#   Arguments: none
#   Returns: 0 always
cmd_list() {
    local file
    shopt -s nullglob
    local -a files=("${PROFILE_DIR}"/*)
    if (( ${#files[@]} == 0 )); then
        echo "No profiles yet. Start with: sv-github setup"
        return 0
    fi
    printf '%-14s %-24s %-20s %s\n' ALIAS HOST LOGIN EMAIL
    for file in "${files[@]}"; do
        printf '%-14s %-24s %-20s %s\n' "$(basename "${file}")" \
            "$(sed -n 's/^HOST=//p' "${file}")" \
            "$(sed -n 's/^LOGIN=//p' "${file}")" \
            "$(sed -n 's/^EMAIL=//p' "${file}")"
    done
}

# cmd_test
#   Tests the SSH connection for one profile, or the main account.
#   Arguments: $1 optional alias
#   Returns: 0 if GitHub accepted the key, 1 otherwise
cmd_test() {
    local host=github.com
    if [[ -n "${1:-}" ]]; then
        host="$(profile_field "$1" HOST)" || die "No profile named '$1'."
    fi
    test_ssh "${host}"
}

# usage
#   Prints command help.
#   Arguments: none
#   Returns: 0 always
usage() {
    sed -n '/^# Usage:/,/^#$/p' "$0" | sed 's/^# \{0,3\}//'
    echo "Guides: ${GUIDES_URL}"
}

# main
#   Dispatches the subcommand.
#   Arguments: $1 subcommand, then its arguments
#   Returns: the subcommand's status, or 64 on bad usage
main() {
    local cmd="${1:-help}"
    shift || true
    case "${cmd}" in
        setup)       cmd_setup "$@" ;;
        add-profile) cmd_add_profile "$@" ;;
        use)         cmd_use "$@" ;;
        clone)       cmd_clone "$@" ;;
        list)        cmd_list ;;
        test)        cmd_test "$@" ;;
        help|-h|--help) usage ;;
        *)           usage >&2; exit 64 ;;
    esac
}

main "$@"
