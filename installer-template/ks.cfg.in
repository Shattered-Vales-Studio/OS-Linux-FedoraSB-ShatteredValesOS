# =============================================================================
# Shattered Vales OS - unattended installer kickstart
#
# WARNING: This erases the selected internal disk without asking.
# Values written as ${SV_*} are filled in by build-iso.sh from secrets.env.
# =============================================================================

# -----------------------------------------------------------------------------
# Hardware detection. Runs before the installer reads the rest of this file
# and writes small include files that pick the image, disk and hostname.
# -----------------------------------------------------------------------------
%pre --interpreter=/usr/bin/bash --erroronfail --log=/tmp/sv-pre.log
set -euo pipefail

REGISTRY="${SV_IMAGE_REGISTRY}"
TAG="${SV_IMAGE_TAG}"
FORCED_DISK="${SV_TARGET_DISK}"
HOST_PREFIX="${SV_HOSTNAME_PREFIX}"

# Choose the NVIDIA image when any display-class device is from vendor 10de.
if lspci -n | awk '$2 ~ /^03/ && $3 ~ /^10de:/ {f=1} END {exit !f}'; then
    IMAGE="${REGISTRY}/shatteredvales-os-nvidia:${TAG}"
else
    IMAGE="${REGISTRY}/shatteredvales-os:${TAG}"
fi

# Pick the target disk: forced value, else the largest internal NVMe, else the
# largest internal non-USB disk. The USB stick and virtual devices are skipped.
# TRAN is listed last because it is empty for virtual disks, which would
# otherwise shift the columns.
if [[ -n "${FORCED_DISK}" ]]; then
    DISK="${FORCED_DISK}"
else
    CANDIDATES="$(lsblk -dnbo NAME,TYPE,RM,SIZE,TRAN \
        | awk '$2=="disk" && $3==0 && $5!="usb" && $1 !~ /^(zram|loop|sr|fd)/')"
    DISK="$(awk '$5=="nvme"' <<<"${CANDIDATES}" | sort -k4,4nr | awk 'NR==1{print $1}')"
    [[ -n "${DISK}" ]] || DISK="$(sort -k4,4nr <<<"${CANDIDATES}" | awk 'NR==1{print $1}')"
fi
[[ -n "${DISK}" ]] || { echo "No internal disk found" >&2; exit 1; }

# Hostname from the hardware serial so machines are identifiable in Tailscale
# and asset lists; falls back to the first network MAC.
SERIAL="$(tr -cd '[:alnum:]' < /sys/class/dmi/id/product_serial 2>/dev/null | tr '[:upper:]' '[:lower:]')"
if [[ -z "${SERIAL}" || "${SERIAL}" == "tobefilledbyoem" || "${SERIAL}" == "defaultstring" ]]; then
    SERIAL="$(cat /sys/class/net/e*/address 2>/dev/null | head -n1 | tr -d ':')"
fi
HOSTNAME="${HOST_PREFIX}-${SERIAL: -8}"

cat > /tmp/sv-source.ks <<KS
ostreecontainer --url=${IMAGE} --transport=registry --no-signature-verification
KS

cat > /tmp/sv-disk.ks <<KS
ignoredisk --only-use=${DISK}
zerombr
clearpart --all --initlabel --drives=${DISK} --disklabel=gpt
bootloader --boot-drive=${DISK}
KS

cat > /tmp/sv-host.ks <<KS
network --hostname=${HOSTNAME}
KS

# After install, move to the signed image so every later update is verified
# against the organization's cosign key.
cat > /tmp/sv-post.ks <<KS
%post --erroronfail --log=/root/sv-post-switch.log
bootc switch --mutate-in-place --enforce-container-sigpolicy --transport registry ${IMAGE}
%end
KS

echo "Image: ${IMAGE}  Disk: ${DISK}  Host: ${HOSTNAME}"
%end

# -----------------------------------------------------------------------------
# Installation settings
# -----------------------------------------------------------------------------
text
reboot --eject
lang ${SV_LANG}
keyboard --vckeymap=${SV_KEYBOARD} --xlayouts='${SV_KEYBOARD}'
timezone ${SV_TIMEZONE} --utc
network --bootproto=dhcp --device=link --activate --onboot=on
%include /tmp/sv-host.ks

%include /tmp/sv-disk.ks
autopart --type=btrfs --noswap

%include /tmp/sv-source.ks

rootpw --lock
user --name=${SV_ADMIN_USER} --gecos="${SV_ADMIN_GECOS}" --groups=wheel --iscrypted --password=${SV_ADMIN_PASSWORD_HASH}
sshkey --username=${SV_ADMIN_USER} "${SV_ADMIN_SSH_PUBKEY}"

%include /tmp/sv-post.ks

# -----------------------------------------------------------------------------
# Join the tailnet on first boot. The key is stored root-only and deleted
# after a successful join so it never lingers on the machine.
# -----------------------------------------------------------------------------
%post --erroronfail --interpreter=/usr/bin/bash --log=/root/sv-post-tailscale.log
install -d -m 0700 /etc/shatteredvales
printf '%s' "${SV_TAILSCALE_AUTHKEY}" > /etc/shatteredvales/tailscale-authkey
chmod 0600 /etc/shatteredvales/tailscale-authkey

cat > /etc/systemd/system/sv-tailscale-join.service <<'UNIT'
[Unit]
Description=Join the Shattered Vales tailnet on first boot
After=network-online.target tailscaled.service
Wants=network-online.target
ConditionPathExists=/etc/shatteredvales/tailscale-authkey

[Service]
Type=oneshot
ExecStart=/usr/bin/bash -c 'tailscale up --auth-key=file:/etc/shatteredvales/tailscale-authkey --hostname="$(hostname)" ${SV_TAILSCALE_UP_ARGS}'
ExecStartPost=/usr/bin/rm -f /etc/shatteredvales/tailscale-authkey
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
UNIT
systemctl enable sv-tailscale-join.service
%end
