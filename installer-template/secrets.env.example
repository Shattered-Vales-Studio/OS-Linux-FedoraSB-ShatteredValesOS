# Copy to secrets.env in the PRIVATE installer repo and fill in.
# Anyone holding a built USB stick can read these values, so use
# short-lived, tagged Tailscale keys and rotate them on a schedule.

SV_IMAGE_REGISTRY="ghcr.io/shattered-vales-studio"
SV_IMAGE_TAG="latest"

SV_LANG="en_US.UTF-8"
SV_KEYBOARD="us"
SV_TIMEZONE="America/Los_Angeles"

# Leave empty for automatic selection (largest internal NVMe, else largest disk).
SV_TARGET_DISK=""
SV_HOSTNAME_PREFIX="sv"

SV_ADMIN_USER="svadmin"
SV_ADMIN_GECOS="Shattered Vales IT"
# Generate with: openssl passwd -6
SV_ADMIN_PASSWORD_HASH='$6$REPLACE_ME'
SV_ADMIN_SSH_PUBKEY="ssh-ed25519 AAAA... it@shatteredvales.studio"

# Reusable, pre-approved, tagged auth key from the Tailscale admin console.
SV_TAILSCALE_AUTHKEY="tskey-auth-REPLACE_ME"
SV_TAILSCALE_UP_ARGS="--advertise-tags=tag:workstation --ssh"
